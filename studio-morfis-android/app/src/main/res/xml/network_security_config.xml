<?xml version="1.0" encoding="utf-8"?>
<!-- The computer serves the app over plain HTTP on the local network (there is no certificate for a home or office PC). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

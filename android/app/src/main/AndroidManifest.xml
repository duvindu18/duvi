<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only asked for when "Embed GPS" is turned on (clip metadata). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Everything runs on the phone: no internet access at all (a library may ask for it). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.VeilCam">
        <!-- Android 16 on tablets / foldables: keep the camera's portrait layout for now
             (the layout also adapts to any window size without restarting the camera). -->
        <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" android:value="true" />
        <!-- A phone camera: the screen layout stays put and the icons turn with the phone,
             as in phone camera apps (recordings follow how the phone is held). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:resizeableActivity="false"
            tools:ignore="LockedOrientationActivity,NonResizeableActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.GalleryActivity" android:exported="false" android:theme="@style/Theme.VeilCam"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />
        <activity android:name=".ui.PlayerActivity" android:exported="false" android:theme="@style/Theme.VeilCam"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />
        <activity android:name=".ui.PhotoActivity" android:exported="false" android:theme="@style/Theme.VeilCam" />
        <!-- Shares a private clip only when the user picks "Share"; nothing is exported otherwise. -->
        <provider android:name=".ui.ClipProvider" android:authorities="com.veil.cam.clips"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>

{
  "name": "Flux.1 schnell text to image (fast)",
  "mode": "text",
  "description": "For flux1-schnell-fp8.safetensors in models/checkpoints (Setup can download it). 4 steps, Apache 2.0 licence. Flux ignores the negative prompt.",
  "bindings": {
    "positive": {
      "node": "6",
      "input": "text"
    },
    "negative": {
      "node": "7",
      "input": "text"
    },
    "seed": {
      "node": "3",
      "input": "seed"
    },
    "steps": {
      "node": "3",
      "input": "steps"
    },
    "checkpoint": {
      "node": "4",
      "input": "ckpt_name"
    },
    "width": {
      "node": "5",
      "input": "width"
    },
    "height": {
      "node": "5",
      "input": "height"
    },
    "prefix": {
      "node": "9",
      "input": "filename_prefix"
    },
    "guidance": {
      "node": "16",
      "input": "guidance"
    }
  },
  "prefer": {
    "checkpoint": "schnell"
  }
}

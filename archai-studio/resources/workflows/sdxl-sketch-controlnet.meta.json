{
  "name": "SDXL sketch to render (ControlNet Canny)",
  "mode": "sketch",
  "description": "Traces the edges of your sketch or massing screenshot, then renders over them. Needs an SDXL Canny ControlNet model in ComfyUI/models/controlnet.",
  "bindings": {
    "positive": { "node": "6", "input": "text" },
    "negative": { "node": "7", "input": "text" },
    "seed": { "node": "3", "input": "seed" },
    "steps": { "node": "3", "input": "steps" },
    "cfg": { "node": "3", "input": "cfg" },
    "checkpoint": { "node": "4", "input": "ckpt_name" },
    "controlnet": { "node": "12", "input": "control_net_name" },
    "strength": { "node": "13", "input": "strength" },
    "image": { "node": "10", "input": "image" },
    "width": { "node": "5", "input": "width" },
    "height": { "node": "5", "input": "height" },
    "prefix": { "node": "9", "input": "filename_prefix" }
  }
}

{
  "name": "archai-studio",
  "productName": "ArchAI Studio",
  "version": "0.1.0",
  "description": "Offline AI studio for architects: chat, scripting and renders using local Ollama and ComfyUI.",
  "author": "Seedform",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run e2e",
    "dist:exe": "npm run build && electron-builder --win nsis --publish never",
    "dist:msix": "npm run build && electron-builder --win appx --publish never",
    "dist": "npm run build && electron-builder --win nsis appx --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "7zip-bin": "^5.2.0",
    "better-sqlite3": "^13.2.0",
    "monaco-editor": "^0.52.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  }
}

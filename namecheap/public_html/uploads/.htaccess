# Uploaded images only: refuse anything that could run as a script.
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|htm|html|svg|js)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
